<Application x:Class="SubZeroPOS.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SubZeroPOS.WPF.Converters">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/SubZeroDarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:ItemImagePathConverter x:Key="ItemImagePathConverter" />

        </ResourceDictionary>
    </Application.Resources>

</Application>