<UserControl x:Class="SubZeroPOS.WPF.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="التقارير" Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="18" FontWeight="Medium" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="رجوع" Command="{Binding BackCommand}"
                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,6" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Date range controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="من:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker SelectedDate="{Binding FromDate}" Width="150" Style="{StaticResource DarkDatePickerStyle}" Margin="0,0,16,0" />
            <TextBlock Text="إلى:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker SelectedDate="{Binding ToDate}" Width="150" Style="{StaticResource DarkDatePickerStyle}" Margin="0,0,16,0" />
            <Button Content="عرض" Command="{Binding LoadReportCommand}"
                    Background="{DynamicResource AccentRedBrush}" Foreground="White" Padding="16,6" Cursor="Hand" >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="IsDefault" Value="True" />
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Quick range shortcuts -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="اليوم" Command="{Binding SetTodayCommand}" Margin="0,0,8,0" Padding="10,5" Cursor="Hand"
                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="آخر 7 أيام" Command="{Binding SetThisWeekCommand}" Margin="0,0,8,0" Padding="10,5" Cursor="Hand"
                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="هذا الشهر" Command="{Binding SetThisMonthCommand}" Padding="10,5" Cursor="Hand"
                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Summary + charts -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Stat cards -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="إجمالي الدخل" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding TotalIncome}" Foreground="{DynamicResource IceBlueBrush}" FontSize="20" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="6,0,6,0">
                        <StackPanel>
                            <TextBlock Text="إجمالي المصروفات" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding TotalExpenses}" Foreground="{DynamicResource ExpenseBrush}" FontSize="20" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="6,0,6,0">
                        <StackPanel>
                            <TextBlock Text="صافي الربح" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding NetProfit}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="عدد الطلبات" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding TotalOrders}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                </Grid>

                 <!-- Daily sales trend (bar chart) -->
                <Border Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="16"
        Margin="0,0,0,14">

                    <StackPanel>

                        <TextBlock Text="اتجاه المبيعات اليومي"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="13"
                   Margin="0,0,0,14" />

                        <!-- START SCROLL VIEWER -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="300">

                            <!-- YOUR ITEMS CONTROL GOES HERE -->
                            <ItemsControl ItemsSource="{Binding DailySalesChart}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <StackPanel Width="46"
                                    Margin="4,0,4,0"
                                    VerticalAlignment="Bottom">

                                            <TextBlock Text="{Binding Total,
                                      StringFormat={}{0:N0}}"
                                       Foreground="{DynamicResource IceBlueBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4" />


                                            <Border Height="{Binding BarHeight}"
                                    Background="{DynamicResource AccentRedBrush}"
                                    CornerRadius="4,4,0,0"
                                    VerticalAlignment="Bottom" />

                                            <TextBlock Text="{Binding DayLabel}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />

                                        </StackPanel>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>
                        <!-- END SCROLL VIEWER -->

                    </StackPanel>

                </Border>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Top selling items -->
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="الأصناف الأكثر مبيعاً" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding TopItemsChart}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ItemName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                                                    <Run Text="{Binding QuantitySold, Mode=OneWay}" />
                                                    <Run Text=" قطعة · " />
                                                    <Run Text="{Binding TotalRevenue, StringFormat={}{0:N0}}" />
                                                </TextBlock>
                                            </Grid>
                                            <Border Grid.Row="1" Height="8" Width="{Binding BarWidth}" HorizontalAlignment="Right"
                                                    Background="{DynamicResource IceBlueBrush}" CornerRadius="4" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Sales by category -->
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="المبيعات حسب القسم" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding CategoriesChart}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding CategoryNameAr}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                                                    <Run Text="{Binding QuantitySold, Mode=OneWay}" />
                                                    <Run Text=" قطعة · " />
                                                    <Run Text="{Binding TotalRevenue, StringFormat={}{0:N0}}" />
                                                </TextBlock>
                                            </Grid>
                                            <Border Grid.Row="1" Height="8" Width="{Binding BarWidth}" HorizontalAlignment="Right"
                                                    Background="{DynamicResource AccentRedBrush}" CornerRadius="4" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Order type / delivery breakdown -->
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="توزيع الطلبات حسب النوع (نسبة التوصيل)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding OrderTypeChart}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12">
                                                    <Run Text="{Binding OrderTypeNameAr}" />
                                                    <Run Text=" (" /><Run Text="{Binding PercentageLabel}" /><Run Text=")" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                                                    <Run Text="{Binding OrderCount, Mode=OneWay}" />
                                                    <Run Text=" طلب · " />
                                                    <Run Text="{Binding TotalRevenue, StringFormat={}{0:N0}}" />
                                                </TextBlock>
                                            </Grid>
                                            <Border Grid.Row="1" Height="8" Width="{Binding BarWidth}" HorizontalAlignment="Right"
                                                    Background="{DynamicResource IceBlueBrush}" CornerRadius="4" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Expenses by category -->
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="المصروفات حسب النوع" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding ExpensesByCategory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding CategoryNameAr}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                                            <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat={}{0:N0}}" Foreground="{DynamicResource ExpenseBrush}" FontSize="13" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
