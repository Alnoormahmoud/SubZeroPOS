<UserControl x:Class="SubZeroPOS.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
              Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>

        <Style x:Key="DeveloperLinkStyle"
           TargetType="{x:Type Hyperlink}">

            <!-- Normal -->
            <Setter Property="Foreground"
                Value="{StaticResource IceBlueBrush}" />

            <Setter Property="TextDecorations"
                Value="{x:Null}" />

            <Style.Triggers>

                <!-- Hover -->
                <Trigger Property="IsMouseOver"
                     Value="True">

                    <Setter Property="Foreground"
                        Value="{StaticResource AccentRedBrush}" />

                    <Setter Property="TextDecorations"
                        Value="Underline" />

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <Grid>
        <Border Width="360"
                Padding="28"
                CornerRadius="14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>

                <!-- Logo (full lockup - icon + name already baked into the image) -->
                <Image Source="pack://siteoforigin:,,,/Images/Branding/logo.png" Stretch="Uniform"
                       Width="200" HorizontalAlignment="Center" Margin="0,10,0,19" />

                <TextBlock Text="تسجيل الدخول"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center" Margin="0,0,0,20" />

                <!-- Username -->
                <TextBlock Text="اسم المستخدم"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="UsernameBox"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14" />

                <!-- Password -->
                <TextBlock Text="كلمة المرور"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox"
                              Style="{StaticResource DarkPasswordBoxStyle}"
                             Margin="0,0,0,10" />

                <DockPanel Margin="0,0,0,10" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding RememberMe}" VerticalAlignment="Bottom"    FlowDirection="LeftToRight" HorizontalAlignment="left"/>
                        <TextBlock Text="تذكرني" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource AccentRedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,10,0,15"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <!-- Login button -->
                <Button Content="تسجيل الدخول"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="LoginButton_Click"
                        IsDefault="True" 
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />


                <!-- System Branding -->
                <StackPanel Margin="0,18,0,0"
            HorizontalAlignment="Center">

                    <!-- System Name -->
                    <TextBlock Text="SubZeroPOS"
               Foreground="{StaticResource TextSecondaryBrush}"
               FontSize="11"
               FontWeight="SemiBold"
               HorizontalAlignment="Center" />

                    <!-- System Description -->
                    <TextBlock Text="نظام متكامل لإدارة المبيعات ونقاط البيع"
               Foreground="{StaticResource TextSecondaryBrush}"
               FontSize="10"
               Opacity="0.75"
               HorizontalAlignment="Center"
               Margin="0,3,0,0" />

                    <!-- Version -->
                    <TextBlock Text="الإصدار 1.0.0"
               Foreground="{StaticResource TextSecondaryBrush}"
               FontSize="10"
               Opacity="0.65"
               HorizontalAlignment="Center"
               Margin="0,3,0,0" />

                    <!-- Developer -->
                    <TextBlock HorizontalAlignment="Center"
           Margin="0,5,0,0"
           FontSize="9">

    <Run Text="تم التطوير بواسطة "
         Foreground="{StaticResource TextSecondaryBrush}"
         />

    <Hyperlink NavigateUri="https://github.com/Alnoormahmoud"
               RequestNavigate="Hyperlink_RequestNavigate"
               Style="{StaticResource DeveloperLinkStyle}">

        <Run Text="Alnoor Mahmoud" />

    </Hyperlink>

                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>

    