<UserControl x:Class="SubZeroPOS.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Border Width="360"
                Padding="28"
                CornerRadius="14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>

                <!-- Logo -->
                <Border Width="72" Height="72"
                        CornerRadius="14"
                        ClipToBounds="True"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                    <Image Source="pack://siteoforigin:,,,/Images/Branding/logo_icon.png" Stretch="Uniform" Margin="8" />
                </Border>
                <TextBlock Text="سوب زيرو"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="20" FontWeight="Medium"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="تسجيل الدخول"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center" Margin="0,0,0,20" />

                <!-- Username -->
                <TextBlock Text="اسم المستخدم"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="UsernameBox"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14" />

                <!-- Password -->
                <TextBlock Text="كلمة المرور"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource DarkPasswordBoxStyle}"
                             Margin="0,0,0,10" />

                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft"
                            HorizontalAlignment="Right" Margin="0,0,0,10">
                    <CheckBox IsChecked="{Binding RememberMe}" VerticalAlignment="Center" />
                    <TextBlock Text="تذكرني" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource AccentRedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <!-- Login button -->
                <Button Content="تسجيل الدخول"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="LoginButton_Click"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
