<UserControl x:Class="SubZeroPOS.WPF.Views.MainDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <StackPanel>
                    <TextBlock Text="ساب زيرو" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="15" FontWeight="Medium" />
                    <TextBlock Text="{Binding WelcomeMessage}"
           Foreground="{DynamicResource IceBlueBrush}"
           FontSize="13"
                               Margin="0,5,0,0"
           FontWeight="Medium" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding CurrentDateTime}" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />


                <Button Content="حسابي"
                Command="{Binding MyAccountCommand}"
                Background="{DynamicResource SurfaceBrush}"
                Foreground="{DynamicResource TextPrimaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="10,6"
                Cursor="Hand"
                Margin="0,0,8,0">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">

                                <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                            </Border>

                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button Content="الإعدادات" Command="{Binding OpenSettingsCommand}"
                        Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" Padding="10,6" Cursor="Hand" Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="تسجيل الخروج"
                        Command="{Binding LogoutCommand}"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" Padding="10,6" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            </StackPanel>
        </Grid>

        <!-- Stat cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="12" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="مبيعات اليوم" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding TodaysSales}" Foreground="{DynamicResource IceBlueBrush}" FontSize="20" FontWeight="Medium" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="12" Margin="6,0,6,0">
                <StackPanel>
                    <TextBlock Text="مصروفات اليوم" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding TodaysExpenses}" Foreground="{DynamicResource ExpenseBrush}" FontSize="20" FontWeight="Medium" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="12" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="عدد الطلبات" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding TodaysOrderCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Medium" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Navigation tiles -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- New Order - always visible (Cashier + Manager) -->
            <Button Grid.Row="0" Grid.Column="0" Command="{Binding NewOrderCommand}"
                    Background="{DynamicResource AccentRedBrush}" Margin="0,0,6,10"
                    Padding="20,18" Cursor="Hand" HorizontalContentAlignment="Right" IsDefault="True" >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock Text="طلب جديد" Foreground="White" FontSize="15" FontWeight="Medium" />
                    <TextBlock Text="فتح شاشة الكاشير" Foreground="White" FontSize="12" Opacity="0.85" />
                </StackPanel>
            </Button>

            <!-- Expenses - always visible -->
            <Button Grid.Row="0" Grid.Column="1" Command="{Binding OpenExpensesCommand}"
                    Background="{DynamicResource SurfaceBrush}" Margin="6,0,0,10"
                    Padding="20,18" Cursor="Hand" HorizontalContentAlignment="Right">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock Text="المصروفات" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Medium" />
                    <TextBlock Text="عرض وإضافة مصروف" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </Button>

            <!-- Previous Orders - always visible, spans both columns -->
            <Button Grid.Row="1" Grid.Column="0" Command="{Binding OpenPreviousOrdersCommand}"
                     Background="{DynamicResource SurfaceBrush}" Margin="0,0,6,10"
                    Padding="20,18" Cursor="Hand" HorizontalContentAlignment="Right">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock Text="الطلبات السابقة" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Medium" />
                    <TextBlock Text="عرض وطباعة طلب سابق" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </Button>

            <!-- Shift - always visible -->
            <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Command="{Binding OpenShiftCommand}"
    Background="{DynamicResource SurfaceBrush}"  Margin="6,0,0,10"
    Padding="20,18" Cursor="Hand" HorizontalContentAlignment="Right">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock Text="الوردية" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Medium" />
                    <TextBlock Text="فتح / إغلاق الوردية" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </Button>

            <!-- Menu Management - Manager only -->
            <Button Grid.Row="2" Grid.Column="1" Command="{Binding OpenMenuManagementCommand}"
                    Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource SurfaceBrush}" Margin="6,0,0,10"
                    Padding="20,18" Cursor="Hand" HorizontalContentAlignment="Right">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock Text="إدارة القائمة" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Medium" />
                    <TextBlock Text="إضافة وتعديل الأصناف والأسعار" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </Button>
            
            

            <!-- User Management - Manager only -->
            <Button Grid.Row="2" Grid.Column="0" Command="{Binding OpenUserManagementCommand}"
                    Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{DynamicResource SurfaceBrush}" Margin="0,0,6,10"
                    Padding="20,18" Cursor="Hand" HorizontalContentAlignment="Right">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock Text="إدارة المستخدمين" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Medium" />
                    <TextBlock Text="إضافة كاشير أو مدير جديد" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </Button>

                <!-- Reports - Manager only -->

                 <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Command="{Binding OpenReportsCommand}"
                             Visibility="{Binding IsManager, Converter={StaticResource BoolToVisibilityConverter}}"

               Background="{DynamicResource SurfaceBrush}" Margin="0,10,0,0"
               Padding="20,18" Cursor="Hand" HorizontalContentAlignment="Right">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                           BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                           CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock Text="التقارير" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="Medium" />
                    <TextBlock Text="الدخل مقابل المصروف" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </Button>

        </Grid>
    </Grid>
</UserControl>
