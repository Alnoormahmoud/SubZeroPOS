<UserControl x:Class="SubZeroPOS.WPF.Views.PreviousOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="الطلبات السابقة" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="18" FontWeight="Medium" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="رجوع" Command="{Binding BackCommand}"
                    Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,6" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <!-- Row 1: date range + quick shortcuts + total -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="من:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <DatePicker SelectedDate="{Binding FromDate}" Width="130" Style="{StaticResource DarkDatePickerStyle}" Margin="0,0,14,0" />
                        <TextBlock Text="إلى:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <DatePicker SelectedDate="{Binding ToDate}" Width="130" Style="{StaticResource DarkDatePickerStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                        <Button Content="اليوم" Command="{Binding SetTodayCommand}" Margin="0,0,8,0" Padding="10,5" Cursor="Hand"
                                Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="آخر 7 أيام" Command="{Binding SetThisWeekCommand}" Margin="0,0,8,0" Padding="10,5" Cursor="Hand"
                                Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="هذا الشهر" Command="{Binding SetThisMonthCommand}" Padding="10,5" Cursor="Hand"
                                Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
 
                </Grid>

                <!-- Row 2: type/payment filters + search -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="النوع:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding OrderTypeFilterOptions}" SelectedItem="{Binding SelectedOrderTypeFilter}" Width="100" Margin="0,0,14,0" />

                    <TextBlock Text="الدفع:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding PaymentFilterOptions}" SelectedItem="{Binding SelectedPaymentFilter}" Width="100" Margin="0,0,14,0" />

                    <Button Content="بحث" Command="{Binding LoadOrdersCommand}"
                            Background="{StaticResource AccentRedBrush}" Foreground="White" Padding="16,6" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="IsDefault" Value="True" />
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- Table -->
        <Border Grid.Row="2"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="20"
        Margin="0,4,0,0">

            <DataGrid ItemsSource="{Binding Orders}"
              Margin="0,12,0,0"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"

              Background="Transparent"
              RowBackground="{StaticResource SurfaceBrush}"
              AlternatingRowBackground="{StaticResource BackgroundBrush}"
              BorderThickness="0"

              HorizontalGridLinesBrush="{StaticResource BorderBrush}"
              Foreground="{StaticResource TextPrimaryBrush}"
              FontSize="13"

              RowHeight="48"

              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Auto">

                <!-- =========================
             COLUMN HEADERS
             ========================= -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1F1F24" />
                        <Setter Property="Foreground"
                        Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="Medium" />

                        <!-- More space inside the header -->
                        <Setter Property="Padding" Value="10,11" />

                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush"
                        Value="{StaticResource AccentRedBrush}" />

                        <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>


                <!-- =========================
             ROW STYLE
             ========================= -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">

                        <!-- Space between header and first row / rows -->
                        <Setter Property="Margin" Value="0,3,0,0" />

                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                </DataGrid.RowStyle>


                <!-- =========================
             CELL STYLE
             ========================= -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">

                        <!-- Horizontal breathing room -->
                        <Setter Property="Padding" Value="10,0" />

                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Background" Value="Transparent" />

                        <Setter Property="VerticalContentAlignment"
                        Value="Center" />
                    </Style>
                </DataGrid.CellStyle>


                <!-- Double click -->
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                          Command="{Binding ViewOrderCommand}"
                          CommandParameter="{Binding SelectedItem,
                              RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                </DataGrid.InputBindings>


                <DataGrid.Columns>

                    <!-- =========================
                 ORDER ID
                 ========================= -->
                    <DataGridTextColumn Header="رقم الطلب"
                                Binding="{Binding OrderId}"
                                Width="85">

                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">

                                <!-- Move ID away from edge -->
                                <Setter Property="Margin" Value="8,0,8,0" />

                                <Setter Property="VerticalAlignment"
                                Value="Center" />

                                <Setter Property="HorizontalAlignment"
                                Value="Center" />

                            </Style>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- =========================
                 DATE
                 ========================= -->
                    <DataGridTextColumn Header="التاريخ والوقت"
                                Binding="{Binding OrderDate,
                                    StringFormat={}{0:yyyy-MM-dd hh:mm}}"
                                Width="145">

                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                Value="Center" />
                                <Setter Property="VerticalAlignment"
                                Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- =========================
                 ORDER TYPE
                 ========================= -->
                    <DataGridTextColumn Header="النوع"
                                Binding="{Binding OrderType.NameAr}"
                                Width="80">

                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment"
                                Value="Center" />
                                <Setter Property="VerticalAlignment"
                                Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- =========================
                 CUSTOMER
                 ========================= -->
                    <DataGridTextColumn Header="الزبون"
                    Binding="{Binding CustomerName}"
                    Width="*">

                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">

                                <!-- Center the customer name under the header -->
                                <Setter Property="HorizontalAlignment"
                    Value="Center" />

                                <Setter Property="VerticalAlignment"
                    Value="Center" />

                                <!-- Let Arabic/English display naturally -->
                                <Setter Property="TextAlignment"
                    Value="Center" />

                                <Setter Property="FlowDirection"
                    Value="LeftToRight" />

                                <Setter Property="Margin"
                    Value="6,0" />

                            </Style>
                        </DataGridTextColumn.ElementStyle>

                    </DataGridTextColumn>


                    <!-- =========================
                 PAYMENT
                 ========================= -->
                    <DataGridTemplateColumn Header="الدفع"
                                    Width="90">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <!-- Center the payment badge -->
                                <Grid HorizontalAlignment="Center"
                              VerticalAlignment="Center">

                                    <Border CornerRadius="8"
                                    Padding="11,4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                        <Border.Style>
                                            <Style TargetType="Border">

                                                <Setter Property="Background"
                                                Value="#2A3B2A" />

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding PaymentMethodCode}"
                                                         Value="Bankak">

                                                        <Setter Property="Background"
                                                        Value="#2A2A3B" />

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </Border.Style>


                                        <TextBlock FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Text"
                                                    Value="نقدي" />

                                                    <Setter Property="Foreground"
                                                    Value="#8FD98F" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding PaymentMethodCode}"
                                                             Value="Bankak">

                                                            <Setter Property="Text"
                                                            Value="بنكك" />

                                                            <Setter Property="Foreground"
                                                            Value="#8F9FD9" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>
                                            </TextBlock.Style>

                                        </TextBlock>

                                    </Border>

                                </Grid>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- =========================
                 TOTAL
                 ========================= -->
                    <DataGridTemplateColumn Header="الإجمالي"
                                    Width="105">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <TextBlock Text="{Binding TotalAmount,
                                      StringFormat={}{0:N0}}"
                                   Foreground="{StaticResource IceBlueBrush}"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- =========================
                 SHOW BUTTON
                 ========================= -->
                    <DataGridTemplateColumn Header=""
                                    Width="65">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <Button Content="عرض"
                                FontSize="10"
                                Padding="8,4"
                                Width="52"
                                Height="30"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="Hand"

                                Command="{Binding DataContext.ViewOrderCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"

                                CommandParameter="{Binding}">

                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{StaticResource AccentRedBrush}"
                                            CornerRadius="6">

                                                <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextElement.Foreground="White" />

                                            </Border>

                                        </ControlTemplate>
                                    </Button.Template>

                                </Button>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>
        </Border>

        <!-- Pagination -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button Content="السابق" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"
                    Padding="14,6" Cursor="Hand" Margin="0,0,10,0"
                    Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock Text="{Binding PageInfoText}" Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />

            <Button Content="التالي" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"
                    Padding="14,6" Cursor="Hand"
                    Background="{StaticResource AccentRedBrush}" Foreground="White" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

    