<UserControl x:Class="SubZeroPOS.WPF.Views.OrderInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             DataContextChanged="OnDataContextChanged"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border x:Name="ReceiptBorder"
                Width="380" Padding="24"
                CornerRadius="14"
                FlowDirection="RightToLeft"
                TextElement.FontFamily="Segoe UI"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,20">
            <StackPanel>

                <!-- Restaurant logo (full lockup - icon + name already baked into the image) -->
               
                    <Image Source="pack://siteoforigin:,,,/Images/Branding/logo.png"
       Stretch="Uniform"
       Width="180"
       HorizontalAlignment="Center"
       Margin="0,0,0,10"
       Visibility="{Binding Order.ShowLogoOnInvoice,
                            Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Restaurant info -->
                <TextBlock Text="{Binding Order.RestaurantAddress}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding Order.RestaurantAddress, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,0,0,2" />
                <TextBlock Text="{Binding Order.RestaurantPhone}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" HorizontalAlignment="Center"
                           Visibility="{Binding Order.RestaurantPhone, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,0,0,10" />


                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,5,0,15" />

                <Border Width="48" Height="48" CornerRadius="24"
                        Background="{StaticResource AccentRedBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="✓" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="تم حفظ الطلب بنجاح" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="17" FontWeight="Medium" HorizontalAlignment="Center" Margin="0, 2,0,8" />
           
                    <TextBlock Text="{Binding Order.OrderId,
                  StringFormat='رقم الطلب: {0}'}"
           Foreground="{StaticResource TextSecondaryBrush}"
           FontSize="12"
           HorizontalAlignment="Center"
           Margin="0,0,0,16"
           Visibility="{Binding Order.ShowOrderNumberOnInvoice,
                                Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,5,0,20" />

                <Grid Margin="0,0,0,4" Visibility="{Binding Order.ShowCashierName, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="الكاشير" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding Order.CashierName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="التاريخ والوقت" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding Order.OrderDateFormatted}"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="نوع الطلب" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding Order.OrderTypeNameAr}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                </Grid>
                <Grid Margin="0,0,0,4" Visibility="{Binding Order.ShouldShowCustomerName,
                           Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="اسم الزبون" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    
                    <TextBlock Grid.Column="1" Text="{Binding Order.CustomerName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="طريقة الدفع" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding Order.PaymentMethodNameAr}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                </Grid>

                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,10" />

                    <StackPanel Margin="0,0,0,10">

                        <!-- Table header -->
                        <Grid Margin="0,0,0,6">

                            <Grid.ColumnDefinitions>

                                <!-- Item -->
                                <ColumnDefinition Width="*" />

                                <!-- Quantity -->
                                <ColumnDefinition Width="55" />

                                <!-- Unit price -->
                                <ColumnDefinition Width="70" />

                                <!-- Total -->
                                <ColumnDefinition Width="75" />

                            </Grid.ColumnDefinitions>


                            <TextBlock Grid.Column="0"
               Text="الصنف"
               FontSize="11"
               FontWeight="Bold"
               Foreground="{StaticResource TextSecondaryBrush}" />


                            <TextBlock Grid.Column="1"
               Text="الكمية"
               FontSize="11"
               FontWeight="Bold"
               Foreground="{StaticResource TextSecondaryBrush}"
               HorizontalAlignment="Center" />


                            <TextBlock Grid.Column="2"
               Text="السعر"
               FontSize="11"
               FontWeight="Bold"
               Foreground="{StaticResource TextSecondaryBrush}"
               HorizontalAlignment="Center" />


                            <TextBlock Grid.Column="3"
               Text="الإجمالي"
               FontSize="11"
               FontWeight="Bold"
               Foreground="{StaticResource TextSecondaryBrush}"
               HorizontalAlignment="Left" />

                        </Grid>


                        <Rectangle Height="1"
           Fill="{StaticResource BorderBrush}"
           Margin="0,5,0,5" />


                        <!-- Items -->
                        <ItemsControl ItemsSource="{Binding Order.Items}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Grid Margin="0,0,0,8">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="55" />

                                            <ColumnDefinition Width="70" />

                                            <ColumnDefinition Width="75" />

                                        </Grid.ColumnDefinitions>


                                        <!-- Item name -->

                                        <TextBlock Grid.Column="0"
                           Text="{Binding ItemName}"
                           FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />


                                        <!-- Quantity -->

                                        <TextBlock Grid.Column="1"
                           Text="{Binding Quantity}"
                           FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />


                                        <!-- Unit price -->

                                        <TextBlock Grid.Column="2"
                           Text="{Binding UnitPrice,
                                          StringFormat={}{0:N0}}"
                           FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />


                                        <!-- Line total -->

                                        <TextBlock Grid.Column="3"
                           Text="{Binding LineTotal,
                                          StringFormat={}{0:N0}}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource IceBlueBrush}"
                           HorizontalAlignment="Left" />

                                    </Grid>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>


                    <Grid Margin="0,0,0,6" Visibility="{Binding Order.HasDeliveryFee, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="رسوم التوصيل" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <TextBlock Grid.Column="1" Text="{Binding Order.DeliveryFee, StringFormat={}{0:N0}}"
                               Foreground="{StaticResource IceBlueBrush}" FontSize="13" />
                </Grid>

                <StackPanel Margin="0,0,0,10" Visibility="{Binding Order.Notes, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="ملاحظات" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Order.Notes}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="الإجمالي" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="16" FontWeight="Medium" />
                    <TextBlock Grid.Column="1" FontSize="16" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}">
                        <Run Text="{Binding Order.TotalAmount, StringFormat={}{0:N0}}" />
                     
  
                        <Run Text=" " />
                        <Run Text="{Binding Order.CurrencySymbol}" />
                    </TextBlock>
                </Grid>

                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,10" />

                <!-- Footer thank-you / policy messages, configurable in Settings -->
                <TextBlock Text="{Binding Order.FooterPrimary}" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="Medium" HorizontalAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding Order.FooterPrimary, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding Order.FooterSecondary}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding Order.FooterSecondary, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,0,0,16" />

                <Button Content="طباعة الفاتورة" Command="{Binding PrintCommand}"
                        Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Padding="12" Margin="0,0,0,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="طلب جديد" Command="{Binding NewOrderCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" />

                <Button Content="{Binding BackButtonLabel}" Command="{Binding GoBackCommand}"
                        Background="Transparent"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        BorderThickness="0" Padding="8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
