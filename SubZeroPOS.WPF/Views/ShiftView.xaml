<UserControl x:Class="SubZeroPOS.WPF.Views.ShiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="الوردية" Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="18" FontWeight="Medium" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="رجوع" Command="{Binding BackCommand}"
                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,6" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <Border Grid.Row="1" Width="420" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">

                <StackPanel>

                <!-- OPEN SHIFT FORM - shown when no shift is currently open -->
                <StackPanel Visibility="{Binding IsShiftOpen, Converter={StaticResource InverseBoolConverter}}">
                    <TextBlock Text="فتح وردية جديدة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,16" />

                    <TextBlock Text="المبلغ الافتتاحي في الدرج" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding OpeningCashText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource DarkTextBoxStyle}" Margin="0,0,0,16" />

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource IceBlueBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Button Content="فتح الوردية" Command="{Binding OpenShiftCommand}"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" IsDefault="True"/>
                </StackPanel>

                <!-- CLOSE SHIFT FORM - shown when a shift is already open -->
                <StackPanel Visibility="{Binding IsShiftOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="الوردية الحالية" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,10,0,16" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="فُتحت بواسطة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding OpenedByName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="وقت الفتح" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding OpenedAtText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="المبلغ الافتتاحي" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding OpeningCashDisplay}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="المتوقع في الدرج الآن" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding ExpectedCashDisplay}" Foreground="{DynamicResource IceBlueBrush}" FontSize="13" FontWeight="Medium" />
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="المبلغ الفعلي في الدرج (بعد العد)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ActualCashText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource DarkTextBoxStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="ملاحظات (اختياري)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding CloseNotes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource DarkTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True"
                             Height="50" Margin="0,0,0,16" />

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource IceBlueBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Button Content="إغلاق الوردية" Command="{Binding CloseShiftCommand}"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                </StackPanel>

            </StackPanel>
            </ScrollViewer>

        </Border>
        <!-- Closing summary popup - shown right after a shift is closed -->
        <Border Background="#CC000000" Visibility="{Binding ShowClosingSummary, Converter={StaticResource BoolToVisibilityConverter}}"
        Grid.RowSpan="2">
            <Border Width="420" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="ملخص إغلاق الوردية" Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="17" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <!-- Number of orders -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                    Grid.Column="0"
                    Text="عدد الطلبات"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    FontSize="13"/>

                        <TextBlock
                    Grid.Column="1"
                    Text="{Binding SummaryOrderCount}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontSize="13"
                    FontWeight="Medium"/>
                    </Grid>

                    <!-- Cash orders -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                    Grid.Column="0"
                    Text="طلبات النقد"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    FontSize="13"/>

                        <TextBlock
                    Grid.Column="1"
                    Text="{Binding SummaryCashOrderCount}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontSize="13"/>
                    </Grid>

                    <!-- Bank orders -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                    Grid.Column="0"
                    Text="طلبات البنك"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    FontSize="13"/>

                        <TextBlock
                    Grid.Column="1"
                    Text="{Binding SummaryBankOrderCount}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontSize="13"/>
                    </Grid>

                    <Rectangle
                Height="1"
                Fill="{DynamicResource BorderBrush}"
                Margin="0,8,0,16"/>

                    <!-- Total sales -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                    Grid.Column="0"
                    Text="إجمالي المبيعات"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    FontSize="13"/>

                        <TextBlock
                    Grid.Column="1"
                    Text="{Binding SummaryTotalSales}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontSize="13"
                    FontWeight="Bold"/>
                    </Grid>

                    <!-- Cash sales -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                    Grid.Column="0"
                    Text="مبيعات النقد"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    FontSize="13"/>

                        <TextBlock
                    Grid.Column="1"
                    Text="{Binding SummaryCashSales}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontSize="13"/>
                    </Grid>

                    <!-- Bank sales -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                    Grid.Column="0"
                    Text="مبيعات البنك"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    FontSize="13"/>

                        <TextBlock
                    Grid.Column="1"
                    Text="{Binding SummaryBankSales}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontSize="13"/>
                    </Grid>

                    <!-- Total Expenses -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
    Grid.Column="0"
    Text="اجمالي المصروفات"
    Foreground="{DynamicResource TextSecondaryBrush}"
    FontSize="13"/>

                        <TextBlock
    Grid.Column="1"
    Text="{Binding SummaryTotalExpensesDisplay}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    FontSize="13"/>
                    </Grid>

                    <Rectangle
                Height="1"
                Fill="{DynamicResource BorderBrush}"
                Margin="0,0,0,16"/>


                    <!-- Opening cash -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
  Grid.Column="0"
  Text="المبلغ الافتتاحي"
  Foreground="{DynamicResource TextSecondaryBrush}"
  FontSize="13"/>

                        <TextBlock
  Grid.Column="1"
  Text="{Binding SummaryOpeningCashDisplay}"
    Foreground="{DynamicResource TextPrimaryBrush}"
  FontSize="13"
  FontWeight="Bold"/>
                        
                    </Grid>
                    <!-- Expected cash -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                    Grid.Column="0"
                    Text="المبلغ المتوقع"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    FontSize="13"/>

                        <TextBlock
                    Grid.Column="1"
                    Text="{Binding SummaryExpected}"
                    Foreground="{DynamicResource IceBlueBrush}"
                    FontSize="14"
                    FontWeight="Bold"/>
                    </Grid>

                    <!-- Actual cash -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                    Grid.Column="0"
                    Text="المبلغ الفعلي"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    FontSize="13"/>

                        <TextBlock
                    Grid.Column="1"
                    Text="{Binding SummaryActual}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    FontSize="14"
                    FontWeight="Bold"/>
                    </Grid>

                    <!-- Difference -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="الفرق" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Medium" />
                        <TextBlock Grid.Column="1" Text="{Binding SummaryDifference}" FontSize="14" FontWeight="Medium">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#8FD98F" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SummaryHasShortage}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    
                    <Button Content="حسناً" Command="{Binding CloseSummaryCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
             
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>