<UserControl x:Class="SubZeroPOS.WPF.Views.ShiftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="الوردية" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="18" FontWeight="Medium" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="رجوع" Command="{Binding BackCommand}"
                    Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,6" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <Border Grid.Row="1" Width="420" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="24">
            <StackPanel>

                <!-- OPEN SHIFT FORM - shown when no shift is currently open -->
                <StackPanel Visibility="{Binding IsShiftOpen, Converter={StaticResource InverseBoolConverter}}">
                    <TextBlock Text="فتح وردية جديدة" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,16" />

                    <TextBlock Text="المبلغ الافتتاحي في الدرج" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding OpeningCashText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,16" />

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource IceBlueBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Button Content="فتح الوردية" Command="{Binding OpenShiftCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                </StackPanel>

                <!-- CLOSE SHIFT FORM - shown when a shift is already open -->
                <StackPanel Visibility="{Binding IsShiftOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="الوردية الحالية" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,10,0,16" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="فُتحت بواسطة" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding OpenedByName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="وقت الفتح" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding OpenedAtText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="المبلغ الافتتاحي" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding OpeningCashDisplay}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="المتوقع في الدرج الآن" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding ExpectedCashDisplay}" Foreground="{StaticResource IceBlueBrush}" FontSize="13" FontWeight="Medium" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="المبلغ الفعلي في الدرج (بعد العد)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ActualCashText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="ملاحظات (اختياري)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding CloseNotes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True"
                             Height="50" Margin="0,0,0,16" />

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource IceBlueBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Button Content="إغلاق الوردية" Command="{Binding CloseShiftCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>