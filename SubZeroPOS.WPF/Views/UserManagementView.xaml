<UserControl x:Class="SubZeroPOS.WPF.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SubZeroPOS.WPF.Converters"
             FlowDirection="RightToLeft"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>

        <converters:BoolToOpacityConverter
            x:Key="BoolToOpacityConverter"/>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="إدارة المستخدمين" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="18" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center">
                    <Run Text="(" /><Run Text="{Binding Users.Count, Mode=OneWay}" /><Run Text=" مستخدم)" />
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Content="رجوع" Command="{Binding BackCommand}"
                    Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,6" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="320" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Add user form -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">

                    <StackPanel>
                    <TextBlock Text="إضافة مستخدم جديد" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,12" />

                    <TextBlock Text="الاسم الكامل" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource DarkTextBoxStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="اسم المستخدم" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource DarkTextBoxStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="كلمة المرور" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource DarkTextBoxStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="الصلاحية" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                              DisplayMemberPath="RoleNameAr" Margin="0,0,0,16" Padding="8" />

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource IceBlueBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Button Content="إضافة المستخدم" Command="{Binding CreateUserCommand}"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" IsDefault="True"/>
                    <Separator Margin="0,20,0,20"
           Background="{DynamicResource BorderBrush}"/>

                    <TextBlock Text="تعديل المستخدم"
           Foreground="{DynamicResource TextSecondaryBrush}"
           FontSize="13"
           Margin="0,0,0,12"/>

                    <TextBlock Text="الاسم الكامل"
           Foreground="{DynamicResource TextSecondaryBrush}"
           FontSize="11"
           Margin="0,0,0,4"/>

                    <TextBox Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}"
         Style="{DynamicResource DarkTextBoxStyle}"
         Margin="0,0,0,12"/>

                    <TextBlock Text="اسم المستخدم"
           Foreground="{DynamicResource TextSecondaryBrush}"
           FontSize="11"
           Margin="0,0,0,4"/>

                    <TextBox Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}"
         Style="{DynamicResource DarkTextBoxStyle}"
         Margin="0,0,0,12"/>

                    <TextBlock Text="كلمة المرور الجديدة"
           Foreground="{DynamicResource TextSecondaryBrush}"
           FontSize="11"
           Margin="0,0,0,4"/>

                    <TextBox Text="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged}"
         Style="{DynamicResource DarkTextBoxStyle}"
         Margin="0,0,0,12"/>

                    <TextBlock Text="الصلاحية"
           Foreground="{DynamicResource TextSecondaryBrush}"
           FontSize="11"
           Margin="0,0,0,4"/>

                    <ComboBox ItemsSource="{Binding Roles}"
          SelectedItem="{Binding EditSelectedRole}"
          DisplayMemberPath="RoleNameAr"
          Margin="0,0,0,16"
          Padding="8"/>

                    <Button Content="حفظ التعديلات"
        Command="{Binding UpdateUserCommand}"
        Style="{DynamicResource PrimaryButtonStyle}"
        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- User list -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Users}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                   Opacity="{Binding IsActive, Converter={StaticResource BoolToOpacityConverter}}">                                     
                                    <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FullName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Medium" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Username}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding Role.RoleNameAr}" Foreground="{DynamicResource IceBlueBrush}" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                            <Button Grid.Column="1"
                                           Content="تعديل"
                                                    FontSize="12"
                                                                                       
                                           Padding="10,6"
                                           Cursor="Hand"
                                           Margin="0,0,6,0"
                                           Command="{Binding DataContext.SelectUserForEditCommand,
                                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                                Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                           BorderThickness="1">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        
                                            <Button Grid.Column="2"
                                                Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,6" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="تعطيل" />
                                                    <Setter Property="Background" Value="{DynamicResource AccentRedBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Content" Value="تفعيل" />
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Grid.Column="3" Content="حذف" FontSize="12" Padding="10,6" Cursor="Hand" Margin="6,0,0,0"
                                                Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Content="السابق" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"
                            Padding="14,6" Cursor="Hand" Margin="0,0,10,0"
                            Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="{Binding PageInfoText}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="التالي" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"
                            Padding="14,6" Cursor="Hand"
                            Background="{DynamicResource AccentRedBrush}" Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
