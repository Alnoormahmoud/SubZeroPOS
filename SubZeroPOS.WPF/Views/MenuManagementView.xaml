<UserControl x:Class="SubZeroPOS.WPF.Views.MenuManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SubZeroPOS.WPF.Converters"
             FlowDirection="RightToLeft"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>

        <converters:BoolToOpacityConverter
            x:Key="BoolToOpacityConverter"/>

    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="إدارة القائمة" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="18" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center">
                    <Run Text="(" /><Run Text="{Binding TotalItemCount, Mode=OneWay}" /><Run Text=" صنف)" />
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Content="رجوع" Command="{Binding BackCommand}"
                    Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,6" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="320" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Left column: Add item + Categories -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Add item form -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="إضافة صنف جديد" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,12" />

                            <TextBlock Text="القسم" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedNewItemCategory}"
                                      DisplayMemberPath="NameAr" Margin="0,0,0,12" Padding="8" />

                            <TextBlock Text="اسم الصنف" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12" />

                            <TextBlock Text="الاسم بالإنجليزية (اختياري)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewItemNameEn, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12" />

                            <TextBlock Text="السعر" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NewItemPriceText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12" />

                            <TextBlock Text="صورة الصنف (اختياري)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding NewItemImageFilePath, TargetNullValue='لم يتم اختيار صورة'}"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="اختيار صورة" Command="{Binding ChooseImageCommand}"
                                        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,6" Cursor="Hand" Margin="6,0,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="2" Content="إزالة" Command="{Binding RemoveNewItemImageCommand}"
                                        Visibility="{Binding NewItemImageFilePath, Converter={StaticResource StringToVisibilityConverter}}"
                                        Background="Transparent" Foreground="{StaticResource AccentRedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,6" Cursor="Hand" Margin="6,0,0,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{StaticResource AccentRedBrush}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <TextBlock Text="{Binding AddItemStatusMessage}" Foreground="{StaticResource IceBlueBrush}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <Button Content="إضافة الصنف" Command="{Binding AddItemCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" IsDefault="True" />
                        </StackPanel>
                    </Border>

                    <!-- Categories: simple list, just name + Edit + Delete -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="الأقسام" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="+ إضافة قسم" Command="{Binding ToggleAddCategoryFormCommand}"
                                        Background="Transparent" Foreground="{StaticResource IceBlueBrush}" BorderThickness="0" Cursor="Hand" FontSize="12">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter TextElement.Foreground="{StaticResource IceBlueBrush}" />
                                        </ControlTemplate>
                                    </Button.Template>                              
                                </Button>
                            </Grid>

                            <StackPanel Visibility="{Binding ShowAddCategoryForm, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,14">
                                <TextBlock Text="اسم القسم" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,10" />
                                <TextBlock Text="الاسم بالإنجليزية (اختياري)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <TextBox Text="{Binding NewCategoryNameEn, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12" />
                                <TextBlock Text="{Binding AddCategoryStatusMessage}"
           Foreground="{StaticResource IceBlueBrush}"
           FontSize="12"
           TextWrapping="Wrap"
           Margin="0,0,0,10" />
                                <Button Content="إضافة القسم" Command="{Binding AddCategoryCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" IsDefault="True" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding NameAr}" Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="13" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="تعديل" FontSize="11" Padding="8,4" Cursor="Hand" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenEditCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="{StaticResource IceBlueBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" >
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>                                             
                                            </Button>
                                            <Button Grid.Column="2" Content="حذف" FontSize="11" Padding="8,4" Cursor="Hand"
                                                    Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Item list: simplified row - thumbnail, name, price, Edit, Delete -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,8"
                                            Opacity="{Binding IsActive, Converter={StaticResource BoolToOpacityConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" ClipToBounds="True" Margin="0,0,10,0">
                                                <Grid>
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource ItemImagePathConverter}}" Stretch="UniformToFill"
                                                           Visibility="{Binding ImagePath, Converter={StaticResource StringToVisibilityConverter}}" />
                                                    <Border Background="{StaticResource AccentRedBrush}"
                                                            Visibility="{Binding HasNoImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding ItemName}" Foreground="White" FontSize="9" FontWeight="Bold"
                                                                   TextWrapping="Wrap" TextAlignment="Center" Margin="2"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Medium" />
                                                <TextBlock Text="{Binding Category.NameAr}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat={}{0:N0}}"
                                                       Foreground="{StaticResource IceBlueBrush}" FontSize="14" FontWeight="Medium"
                                                       VerticalAlignment="Center" Margin="0,0,14,0" />

                                            <Button Grid.Column="3" Content="تعديل" FontSize="12" Padding="12,6" Cursor="Hand" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenEditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{StaticResource AccentRedBrush}" Foreground="White" BorderThickness="0" >
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>                                 
                                            </Button>

                                            <Button Grid.Column="4" Content="حذف" FontSize="12" Padding="12,6" Cursor="Hand"
                                                    Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="السابق" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"
                                Padding="14,6" Cursor="Hand" Margin="0,0,10,0"
                                Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="{Binding PageInfoText}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="التالي" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"
                                Padding="14,6" Cursor="Hand"
                                Background="{StaticResource AccentRedBrush}" Foreground="White" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Edit Item modal overlay -->
        <Grid Grid.RowSpan="2" Background="#CC000000" Visibility="{Binding IsItemEditOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="420" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">

                    <StackPanel>
                    <TextBlock Text="تعديل الصنف" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Medium" Margin="0,0,0,16" />

                    <TextBlock Text="اسم الصنف" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding EditItemName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="الاسم بالإنجليزية (اختياري)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding EditItemNameEn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="القسم" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding EditItemCategory}"
                              DisplayMemberPath="NameAr" Margin="0,0,0,12" Padding="8" />

                    <TextBlock Text="السعر" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding EditItemPriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12" />

                    <CheckBox Content="مفعّل" IsChecked="{Binding EditItemIsActive}" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,12" />

                    <TextBlock Text="صورة الصنف" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />

                    <Border Width="90" Height="90" CornerRadius="10" ClipToBounds="True"
                            HorizontalAlignment="Right" Margin="0,0,0,10">
                        <Grid>
                            <Image Source="{Binding EditItemImagePath, Converter={StaticResource ItemImagePathConverter}}" Stretch="UniformToFill"
                                   Visibility="{Binding EditItemImagePath, Converter={StaticResource StringToVisibilityConverter}}" />
                            <Border Background="{StaticResource AccentRedBrush}"
                                    Visibility="{Binding EditItemHasNoImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding EditItemName}" Foreground="White" FontSize="11" FontWeight="Bold"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding EditItemImagePath, TargetNullValue='لا توجد صورة'}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="تغيير" Command="{Binding ChangeEditItemImageCommand}" Margin="6,0,0,0" Padding="10,6" Cursor="Hand"
                                Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" Content="إزالة" Command="{Binding RemoveEditItemImageCommand}" Margin="6,0,0,0" Padding="10,6" Cursor="Hand"
                                Background="Transparent" Foreground="{StaticResource AccentRedBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{StaticResource AccentRedBrush}" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding EditItemStatusMessage}" Foreground="{StaticResource IceBlueBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="إلغاء" Command="{Binding CancelEditItemCommand}" Padding="12" Cursor="Hand"
                                Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" Content="حفظ" Command="{Binding SaveEditedItemCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Edit Category modal overlay -->
        <Grid Grid.RowSpan="2" Background="#CC000000" Visibility="{Binding IsCategoryEditOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="360" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="تعديل القسم" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Medium" Margin="0,0,0,16" />

                    <TextBlock Text="اسم القسم" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding EditCategoryName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12" />

                    <TextBlock Text="الاسم بالإنجليزية (اختياري)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                    <TextBox Text="{Binding EditCategoryNameEn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,16" />

                    <TextBlock Text="{Binding EditCategoryStatusMessage}" Foreground="{StaticResource IceBlueBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="إلغاء" Command="{Binding CancelEditCategoryCommand}" Padding="12" Cursor="Hand"
                                Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" Content="حفظ" Command="{Binding SaveEditedCategoryCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
