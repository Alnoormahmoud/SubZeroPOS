<UserControl x:Class="SubZeroPOS.WPF.Views.OrderEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="طلب جديد"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="18" FontWeight="Medium" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="رجوع" Click="BackButton_Click"
                    Background="{StaticResource SurfaceBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="12,6" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Category tabs (includes "الكل" pseudo-category first) -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding NameAr}"
                                Command="{Binding DataContext.SelectCategoryCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Margin="0,0,6,0" Padding="14,8" Cursor="Hand"
                                Background="{StaticResource SurfaceBrush}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Item grid + Cart side by side - flexible/stretchy columns -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Item grid: cards with image + name + price, wraps and reflows as window resizes -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                <ItemsControl ItemsSource="{Binding ItemsInCategory}" Margin="0,0,4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.AddToCartCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Width="150" Height="150" Margin="0,0,10,10" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Image if ImagePath is set -->
                                                <Border Grid.Row="0" CornerRadius="10,10,0,0" ClipToBounds="True">
                                                    <Grid>
                                                        <!-- Real photo -->
                                                        <Image Source="{Binding ImagePath, Converter={StaticResource ItemImagePathConverter}}" Stretch="UniformToFill"
                                                               Visibility="{Binding ImagePath, Converter={StaticResource StringToVisibilityConverter}}" />
                                                        <!-- Placeholder when no photo yet: colored box with first letter -->
                                                        <Border Background="{StaticResource AccentRedBrush}"
                                                                Visibility="{Binding HasNoImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding ItemName}"
                                                                       Foreground="White"
                                                                       FontSize="16" FontWeight="Bold"
                                                                       TextWrapping="Wrap" TextAlignment="Center"
                                                                       Margin="6"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Opacity="0.9" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Row="1" Margin="8,6,8,8">
                                                    <TextBlock Text="{Binding ItemName}" Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,4" />
                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:0.000}}"
                                                               Foreground="{StaticResource IceBlueBrush}" FontSize="12" TextAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Cart -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="السلة" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="13" Margin="0,0,0,8" />

                    <!-- Cart items AND the order-details form share one scrollable
                         region, so the item list isn't squeezed by the form's
                         height. Only the total + checkout button stay pinned
                         at the bottom, always visible without scrolling. -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Cart}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ItemName}"
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LineTotal, StringFormat={}{0:0.000}}"
                                                       Foreground="{StaticResource IceBlueBrush}" FontSize="13" />

                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                        Orientation="Horizontal" Margin="0,4,0,0">
                                                <Button Content="-" Width="24" Height="24"
                                                        Command="{Binding DataContext.DecreaseQuantityCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Margin="0,0,6,0" Cursor="Hand" />
                                                <TextBlock Text="{Binding Quantity}" Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <Button Content="+" Width="24" Height="24"
                                                        Command="{Binding DataContext.IncreaseQuantityCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Margin="0,0,6,0" Cursor="Hand" />
                                                <Button Content="حذف" FontSize="11"
                                                        Command="{Binding DataContext.RemoveFromCartCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Cursor="Hand" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,12" />

                            <!-- Order type (صالة / توصيل / استلام) -->
                            <TextBlock Text="نوع الطلب" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding OrderTypes}" SelectedItem="{Binding SelectedOrderType}"
                                      DisplayMemberPath="NameAr" Margin="0,0,0,10" Padding="8" />

                            <!-- Customer name -->
                            <TextBlock Text="اسم الزبون (اختياري)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,10" />

                            <!-- Delivery fee - only shown when order type is Delivery -->
                            <StackPanel Visibility="{Binding IsDeliverySelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="رسوم التوصيل" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <TextBox Text="{Binding DeliveryFeeText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,10" />
                            </StackPanel>

                            <!-- Notes -->
                            <TextBlock Text="ملاحظات (اختياري)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True"
                                     Height="50" Margin="0,0,0,10" />

                            <!-- Payment method -->
                            <TextBlock Text="طريقة الدفع" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}"
                                      DisplayMemberPath="NameAr" Margin="0,0,0,4" Padding="8" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Pinned at the bottom - always visible without scrolling -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الإجمالي" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="15" FontWeight="Medium" />
                            <TextBlock Grid.Column="1" Text="{Binding GrandTotal, StringFormat={}{0:0.000}}"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Medium" />
                        </Grid>

                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource IceBlueBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="إلغاء" Command="{Binding CancelOrderCommand}"
                                    Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="12" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" Content="تأكيد الطلب" Command="{Binding CompleteOrderCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
